{
    "name": "inupress/core",
    "description": "Inupress CMS core: plugin discovery, plugin manager, hooks",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "inupress/contracts": "^0.1",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Inupress\\Core\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Inupress\\Core\\CoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
